{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redwood.local/schemas/source-registry/v1",
  "title": "Redwood Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "sourceVersions", "artifacts", "adapters", "routingPolicies"],
  "properties": {
    "schemaVersion": { "const": "redwood.source-registry/v1" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "sourceVersions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceVersion" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/adapter" } },
    "routingPolicies": { "type": "array", "items": { "$ref": "#/$defs/routingPolicy" } }
  },
  "$defs": {
    "sourceVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "version", "provenanceClass", "rights", "custody", "reacquisition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
        "provenanceClass": { "enum": ["observed_public", "synthetic_owned", "derived", "restricted", "reference_only"] },
        "rights": { "type": "object", "additionalProperties": false, "required": ["use", "retain", "reviewRef"], "properties": { "use": { "enum": ["permitted", "license_required", "consent_required", "reference_only"] }, "retain": { "enum": ["permitted", "bounded_only", "prohibited"] }, "reviewRef": { "type": "string", "minLength": 1 } } },
        "custody": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceRef"], "properties": { "status": { "enum": ["PHYSICALLY_HELD", "DERIVED_REPRODUCIBLE", "REACQUIRE_ON_DEMAND", "LICENSE_REQUIRED", "CONSENT_REQUIRED", "REFERENCE_ONLY", "NOT_YET_ACQUIRED"] }, "evidenceRef": { "type": "string", "minLength": 1 }, "locationRef": { "type": "string" } } },
        "reacquisition": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["none", "official_download", "official_api_query", "sanctioned_manual_export", "derivation"] }, "recipeRef": { "type": "string" }, "receiptRequired": { "type": "boolean" } } }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceVersionId", "population", "format", "engineEligibility", "adapterId"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "sourceVersionId": { "type": "string", "minLength": 1 }, "population": { "type": "string", "minLength": 1 }, "format": { "enum": ["csv", "tsv", "xlsx", "json", "zip", "other"] }, "engineEligibility": { "enum": ["ingestible", "reference_only", "test_only", "quarantined"] }, "adapterId": { "type": "string", "minLength": 1 }, "engineSourceType": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "derivesFromArtifactIds": { "type": "array", "items": { "type": "string" } } }
    },
    "adapter": { "type": "object", "additionalProperties": false, "required": ["id", "version", "formats", "networkAccess"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "formats": { "type": "array", "minItems": 1, "items": { "enum": ["csv", "tsv", "xlsx", "json", "zip", "other"] } }, "networkAccess": { "const": "forbidden" } } },
    "routingPolicy": { "type": "object", "additionalProperties": false, "required": ["id", "requiresArtifactIds", "supersedesPopulations", "retainsEngineSourceTypes"], "properties": { "id": { "type": "string", "minLength": 1 }, "requiresArtifactIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "supersedesPopulations": { "type": "array", "items": { "type": "string" } }, "retainsEngineSourceTypes": { "type": "array", "items": { "type": "string" } }, "crosswalkPolicy": { "enum": ["none", "system_qualified_explicit"] } } }
  }
}
